{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "json.schemas": [
    {
      "fileMatch": [
        ".markdownlint.json",
        ".markdownlint.jsonc",
        ".markdownlint-cli2.json",
        ".markdownlint-cli2.jsonc"
      ],
      "url": "./.vscode/markdownlint-config-schema.json"
    }
  ]
}
