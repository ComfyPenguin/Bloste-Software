<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sitio Web Principal -->
        <record id="bloste_website" model="website">
            <field name="name">Bloste</field>
            <field name="domain" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Templates -->
        <template id="home_page_view" name="Página de Inicio">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12 text-center">
                            <h1>Bienvenido a Bloste</h1>
                            <p class="lead">Plataforma de streaming de contenido</p>
                            <a href="/suscripciones" class="btn btn-primary btn-lg mt-3">
                                Ver Planes
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="suscripciones_page_view" name="Página Suscripciones">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row mb-4">
                        <div class="col-12">
                            <h1>Planes de Suscripción</h1>
                            <p class="text-muted">Elige el plan que mejor se adapta a ti</p>
                        </div>
                    </div>

                    <div class="row" t-if="subscriptions">
                        <t t-foreach="subscriptions" t-as="sub">
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 shadow">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <t t-esc="sub.name"/>
                                        </h5>
                                        
                                        <h3 class="text-primary my-3">
                                            $<t t-esc="'%.2f' % sub.price"/>
                                            <span class="fs-6">/mes</span>
                                        </h3>
                                        
                                        <ul class="list-unstyled mb-4">
                                            <li class="mb-2">
                                                <i class="fa fa-calendar text-info"></i>
                                                <t t-esc="sub.duration"/> días
                                            </li>
                                            <li class="mb-2">
                                                <i class="fa fa-users text-success"></i>
                                                <t t-esc="len(sub.user_subscription_ids)"/> usuarios
                                            </li>
                                        </ul>
                                        
                                        <a t-attf-href="/info-usuario?plan={{sub.name}}" class="btn btn-primary w-100">
                                            Suscribirse
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="row" t-else="">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <p>No hay planes disponibles</p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="contactus_page_view" name="Página Contact Us">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12">
                            <h1>Contact Us</h1>
                            <p class="lead mt-4">¿Tienes preguntas? Nos encantaría saber de ti.</p>
                            
                            <div class="row mt-5">
                                <div class="col-md-8 offset-md-2">
                                    <form method="post" action="/contactus/submit" class="card p-4">
                                        <div class="mb-3">
                                            <label class="form-label">Nombre</label>
                                            <input type="text" class="form-control" name="name" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" name="email" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Mensaje</label>
                                            <textarea class="form-control" name="message" rows="5" required="required"></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Enviar Mensaje</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="contactus_thankyou_page_view" name="Página Thanks Contact Us">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12 text-center">
                            <div class="alert alert-success p-5">
                                <h1 class="display-4">¡Gracias por contactarnos!</h1>
                                <p class="lead mt-4">Hemos recibido tu mensaje y te responderemos pronto.</p>
                                <a href="/" class="btn btn-primary mt-3">Volver al Inicio</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="info_usuario_page_view" name="Página Info Usuario">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-md-8 offset-md-2">
                            <h1>Información de Usuario</h1>
                            <p class="lead text-muted">Completa tus datos para contratar el plan</p>
                            
                            <div class="card mt-4">
                                <div class="card-body">
                                    <form method="post" action="/info-usuario/submit">
                                        <div class="mb-3">
                                            <label class="form-label">Plan a contratar</label>
                                            <input type="text" class="form-control" name="plan" t-att-value="plan or ''" readonly="readonly" required="required" style="background-color: #e9ecef;"/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">Nombre Completo</label>
                                            <input type="text" class="form-control" name="name" required="required"/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" name="email" required="required"/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">Teléfono</label>
                                            <input type="tel" class="form-control" name="phone" required="required"/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">Dirección</label>
                                            <textarea class="form-control" name="address" rows="3" required="required"></textarea>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-success w-100 mt-3">Confirmar Suscripción</button>
                                        <a href="/suscripciones" class="btn btn-secondary w-100 mt-2">Volver a Planes</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <script>
                        // Capturar el parámetro 'plan' de la URL si existe
                        document.addEventListener('DOMContentLoaded', function() {
                            console.log('Ejecutando script de auto-rellenado de plan');
                            var urlParams = new URLSearchParams(window.location.search);
                            var plan = urlParams.get('plan');
                            console.log('Plan desde URL:', plan);
                            
                            if (plan) {
                                // Intentar múltiples selectores
                                var selectors = [
                                    'input[name="plan"]',
                                    'input[name="Plan a contratar"]',
                                    'input[id*="plan"]',
                                    'input.form-control',
                                    'input[type="text"]'
                                ];
                                
                                var planFilled = false;
                                
                                selectors.forEach(function(selector) {
                                    var inputs = document.querySelectorAll(selector);
                                    console.log('Buscando con selector:', selector, 'encontrados:', inputs.length);
                                    
                                    inputs.forEach(function(input) {
                                        // Verificar si el input tiene una etiqueta relacionada con "plan"
                                        var label = input.previousElementSibling || 
                                                   document.querySelector('label[for="' + input.id + '"]');
                                        var labelText = label ? label.textContent.toLowerCase() : '';
                                        
                                        console.log('Input:', input, 'Label:', labelText);
                                        
                                        if (labelText.includes('plan') || input.name.toLowerCase().includes('plan')) {
                                            input.value = decodeURIComponent(plan);
                                            console.log('Plan rellenado en input:', input);
                                            planFilled = true;
                                        }
                                    });
                                });
                                
                                if (!planFilled) {
                                    console.warn('No se pudo encontrar el campo del plan para auto-rellenar');
                                }
                            }
                        });
                    </script>
                </div>
            </t>
        </template>

        <template id="login_registro_page_view" name="Página Inicio Sesión o Registro">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-md-6 offset-md-3">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h2>Bienvenido a Bloste</h2>
                                </div>
                                <div class="card-body">
                                    <ul class="nav nav-tabs mb-4" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-bs-toggle="tab" href="#login">Iniciar Sesión</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" href="#register">Registrarse</a>
                                        </li>
                                    </ul>

                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="login">
                                            <form method="post" action="/web/login">
                                                <div class="mb-3">
                                                    <label class="form-label">Email</label>
                                                    <input type="email" class="form-control" name="login" required="required"/>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Contraseña</label>
                                                    <input type="password" class="form-control" name="password" required="required"/>
                                                </div>
                                                <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
                                            </form>
                                        </div>

                                        <div class="tab-pane fade" id="register">
                                            <form method="post" action="/web/signup">
                                                <div class="mb-3">
                                                    <label class="form-label">Nombre Completo</label>
                                                    <input type="text" class="form-control" name="name" required="required"/>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Email</label>
                                                    <input type="email" class="form-control" name="login" required="required"/>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Contraseña</label>
                                                    <input type="password" class="form-control" name="password" required="required"/>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Confirmar Contraseña</label>
                                                    <input type="password" class="form-control" name="confirm_password" required="required"/>
                                                </div>
                                                <button type="submit" class="btn btn-success w-100">Registrarse</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="subscription_success_view" name="Página Éxito Suscripción">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12 text-center">
                            <div class="alert alert-success p-5">
                                <h1 class="display-4">¡Gracias por tu suscripción!</h1>
                                <p class="lead mt-4">Hemos recibido tu solicitud de suscripción.</p>
                                <p>Te enviaremos un correo con los detalles de tu plan y las instrucciones de pago.</p>
                                <a href="/" class="btn btn-primary mt-3">Volver al Inicio</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Páginas -->
        <record id="website_page_home" model="website.page">
            <field name="name">Inicio</field>
            <field name="url">/</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.home_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published">True</field>
        </record>

        <record id="website_page_contactus" model="website.page">
            <field name="name">Contact Us</field>
            <field name="url">/contactus</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.contactus_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published">True</field>
        </record>

        <record id="website_page_contactus_thankyou" model="website.page">
            <field name="name">Thanks (Contact us)</field>
            <field name="url">/contactus-thank-you</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.contactus_thankyou_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published">True</field>
        </record>

        <record id="website_page_subscription_success" model="website.page">
            <field name="name">Éxito Suscripción</field>
            <field name="url">/subscription-success</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.subscription_success_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published">True</field>
        </record>

        <record id="website_page_login_registro" model="website.page">
            <field name="name">Inicio sesión o registro</field>
            <field name="url">/inicio-sesio-o-registro</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.login_registro_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>

