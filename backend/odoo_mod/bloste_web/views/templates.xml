<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extender el layout del website para incluir el JavaScript -->
    <template id="layout" inherit_id="website.layout" name="Bloste Web Scripts">
        <xpath expr="//head" position="inside">
            <script type="text/javascript" src="/bloste_web/static/src/js/subscription_redirect.js"/>
        </xpath>
    </template>

    <!-- Template: Login/Registro -->
    <template id="login_register_template" name="Iniciar Sesión o Registrarse">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-md-6 offset-md-3">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h2>Bienvenido a Bloste</h2>
                            </div>
                            <div class="card-body">
                                <ul class="nav nav-tabs mb-4" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-bs-toggle="tab" href="#login">Iniciar Sesión</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" href="#register">Registrarse</a>
                                    </li>
                                </ul>

                                <div class="tab-content">
                                    <!-- Login Tab -->
                                    <div class="tab-pane fade show active" id="login">
                                        <form method="post" action="/web/login">
                                            <div class="mb-3">
                                                <label for="login_email" class="form-label">Email</label>
                                                <input type="email" class="form-control" id="login_email" name="login" placeholder="correo@ejemplo.com" required="required"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="login_password" class="form-label">Contraseña</label>
                                                <input type="password" class="form-control" id="login_password" name="password" placeholder="Tu contraseña" required="required"/>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
                                        </form>
                                    </div>

                                    <!-- Register Tab -->
                                    <div class="tab-pane fade" id="register">
                                        <form method="post" action="/web/signup">
                                            <div class="mb-3">
                                                <label for="register_name" class="form-label">Nombre Completo</label>
                                                <input type="text" class="form-control" id="register_name" name="name" placeholder="Tu nombre" required="required"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="register_email" class="form-label">Email</label>
                                                <input type="email" class="form-control" id="register_email" name="login" placeholder="correo@ejemplo.com" required="required"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="register_password" class="form-label">Contraseña</label>
                                                <input type="password" class="form-control" id="register_password" name="password" placeholder="Tu contraseña" required="required"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="register_password_confirm" class="form-label">Confirmar Contraseña</label>
                                                <input type="password" class="form-control" id="register_password_confirm" name="confirm_password" placeholder="Confirma tu contraseña" required="required"/>
                                            </div>
                                            <button type="submit" class="btn btn-success w-100">Registrarse</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template: Suscripción ya existe -->
    <template id="subscription_exists" name="Suscripción Existente">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-12 text-center">
                        <div class="alert alert-warning p-5">
                            <h1 class="display-4">¡Ya tienes una suscripción activa!</h1>
                            <p class="lead mt-4">
                                Ya cuentas con el plan <strong><t t-esc="subscription.name"/></strong>
                            </p>
                            <a href="/" class="btn btn-primary mt-3">Volver al Inicio</a>
                            <a href="/suscripciones" class="btn btn-secondary mt-3">Ver otros planes</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
