<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sitio Web Principal - siempre se actualiza -->
        <record id="bloste_website" model="website">
            <field name="name">Bloste</field>
            <field name="domain" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Home Page -->
        <record id="website_page_home" model="website.page">
            <field name="name">Inicio</field>
            <field name="url">/</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.home_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Suscripciones Page -->
        <record id="website_page_suscripciones" model="website.page">
            <field name="name">Suscripciones</field>
            <field name="url">/suscripciones</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.suscripciones_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Contact Us Page -->
        <record id="website_page_contactus" model="website.page">
            <field name="name">Contact Us</field>
            <field name="url">/contactus</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.contactus_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Thank You Page -->
        <record id="website_page_contactus_thankyou" model="website.page">
            <field name="name">Thanks (Contact us)</field>
            <field name="url">/contactus-thank-you</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.contactus_thankyou_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Info Usuario Page -->
        <record id="website_page_info_usuario" model="website.page">
            <field name="name">Info usuario</field>
            <field name="url">/info-usuario</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.info_usuario_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Subscription Success Page -->
        <record id="website_page_subscription_success" model="website.page">
            <field name="name">Éxito Suscripción</field>
            <field name="url">/subscription-success</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.subscription_success_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Login/Registro Page -->
        <record id="website_page_login_registro" model="website.page">
            <field name="name">Inicio sesión o registro</field>
            <field name="url">/inicio-sesio-o-registro</field>
            <field name="type">qweb</field>
            <field name="view_id" ref="bloste_web.login_registro_page_view"/>
            <field name="website_id" ref="bloste_web.bloste_website"/>
            <field name="is_published" eval="True"/>
        </record>
    </data>
</odoo>
