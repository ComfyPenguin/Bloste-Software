<odoo>
    <record id="seq_bloste_subscription" model="ir.sequence">
        <field name="name">Secuencia de Suscripciones Bloste</field>
        <field name="code">bloste.subscription</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="view_bloste_subscription_tree" model="ir.ui.view">
        <field name="name">bloste.subscription.tree</field>
        <field name="model">bloste.subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="display_name" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_bloste_subscription_form" model="ir.ui.view">
        <field name="name">bloste.subscription.form</field>
        <field name="model">bloste.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Información del Plan">
                            <field name="product_id"/>
                            <field name="price"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group string="Venta y Cliente">
                        <field name="sale_order_id"/>
                        <field name="partner_id"/>
                    </group>
                    <separator string="Usuarios Suscritos"/>
                    <field name="user_subscription_ids">
                        <tree>
                            <field name="user_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bloste_subscription" model="ir.actions.act_window">
        <field name="name">Suscripciones</field>
        <field name="res_model">bloste.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>