<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_subscription_tree" model="ir.ui.view">
        <field name="name">bloste.user_subscription.tree</field>
        <field name="model">bloste.user_subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id"/>
                <field name="subscription_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="view_user_subscription_form" model="ir.ui.view">
        <field name="name">bloste.user_subscription.form</field>
        <field name="model">bloste.user_subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="subscription_id"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
