<odoo>
    <template id="mi_layout_personalizado" inherit_id="website.layout">
        <xpath expr="//footer" position="inside">
            <p>Derechos Reservados - Bloste</p>
        </xpath>
    </template>

    <!-- Template para la vista de Usuarios Normales vs Administradores con sus Suscripciones -->
    <template id="users_admins_template" name="Usuarios y Administradores">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">Gestión de Usuarios</h1>
                        
                        <!-- Tabs Navigation -->
                        <ul class="nav nav-tabs mb-4" id="usersAdminsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-content" type="button" role="tab" aria-controls="users-content" aria-selected="true">
                                    <i class="fa fa-user"></i> Usuarios Normales
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="admins-tab" data-bs-toggle="tab" data-bs-target="#admins-content" type="button" role="tab" aria-controls="admins-content" aria-selected="false">
                                    <i class="fa fa-shield"></i> Administradores
                                </button>
                            </li>
                        </ul>

                        <!-- Tabs Content -->
                        <div class="tab-content" id="usersAdminsContent">
                            
                            <!-- Pestaña: Usuarios Normales con Suscripciones -->
                            <div class="tab-pane fade show active" id="users-content" role="tabpanel" aria-labelledby="users-tab">
                                <div class="card">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">Usuarios Normales y sus Suscripciones (<span t-out="len(all_users)"></span>)</h5>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="all_users">
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Nombre</th>
                                                            <th>Email</th>
                                                            <th>Login</th>
                                                            <th>Plan de Suscripción</th>
                                                            <th>Precio Mensual</th>
                                                            <th>Fecha Inicio</th>
                                                            <th>Fecha Vencimiento</th>
                                                            <th>Estado</th>
                                                            <th>Activo</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="all_users" t-as="user">
                                                            <t t-set="subscriptions" t-value="user.subscription_ids"/>
                                                            <t t-if="len(subscriptions) > 0">
                                                                <t t-foreach="subscriptions" t-as="sub">
                                                                    <tr>
                                                                        <td><t t-out="user.id"></t></td>
                                                                        <td><strong><t t-out="user.name"></t></strong></td>
                                                                        <td><t t-out="user.email or 'N/A'"></t></td>
                                                                        <td><code><t t-out="user.login"></t></code></td>
                                                                        <td><t t-out="sub.name or 'N/A'"></t></td>
                                                                        <td>
                                                                            <t t-if="sub.price">
                                                                                <span class="badge bg-info">$<t t-out="'{:.2f}'.format(sub.price)"></t></span>
                                                                            </t>
                                                                            <t t-else="">N/A</t>
                                                                        </td>
                                                                        <td><t t-out="sub.start_date or 'N/A'"></t></td>
                                                                        <td><t t-out="sub.end_date or 'N/A'"></t></td>
                                                                        <td>
                                                                            <t t-if="sub.state == 'active'">
                                                                                <span class="badge bg-success">Activa</span>
                                                                            </t>
                                                                            <t t-elif="sub.state == 'expired'">
                                                                                <span class="badge bg-danger">Caducada</span>
                                                                            </t>
                                                                            <t t-else="">
                                                                                <span class="badge bg-secondary"><t t-out="sub.state"></t></span>
                                                                            </t>
                                                                        </td>
                                                                        <td>
                                                                            <t t-if="user.active">
                                                                                <span class="badge bg-success">Sí</span>
                                                                            </t>
                                                                            <t t-else="">
                                                                                <span class="badge bg-danger">No</span>
                                                                            </t>
                                                                        </td>
                                                                    </tr>
                                                                </t>
                                                            </t>
                                                            <t t-else="">
                                                                <tr>
                                                                    <td><t t-out="user.id"></t></td>
                                                                    <td><strong><t t-out="user.name"></t></strong></td>
                                                                    <td><t t-out="user.email or 'N/A'"></t></td>
                                                                    <td><code><t t-out="user.login"></t></code></td>
                                                                    <td colspan="5" class="text-muted"><em>Sin suscripción</em></td>
                                                                    <td>
                                                                        <t t-if="user.active">
                                                                            <span class="badge bg-success">Sí</span>
                                                                        </t>
                                                                        <t t-else="">
                                                                            <span class="badge bg-danger">No</span>
                                                                        </t>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-info">
                                                <i class="fa fa-info-circle"></i> No hay usuarios normales registrados.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Pestaña: Administradores -->
                            <div class="tab-pane fade" id="admins-content" role="tabpanel" aria-labelledby="admins-tab">
                                <div class="card">
                                    <div class="card-header bg-danger text-white">
                                        <h5 class="mb-0">Administradores (<span t-out="len(admins)"></span>)</h5>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="admins">
                                            <div class="table-responsive">
                                                <table class="table table-striped table-hover">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Nombre</th>
                                                            <th>Email</th>
                                                            <th>Login</th>
                                                            <th>Teléfono</th>
                                                            <th>Empresa</th>
                                                            <th>Activo</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="admins" t-as="admin">
                                                            <tr>
                                                                <td><t t-out="admin.id"></t></td>
                                                                <td><strong><t t-out="admin.name"></t></strong></td>
                                                                <td><t t-out="admin.email or 'N/A'"></t></td>
                                                                <td><code><t t-out="admin.login"></t></code></td>
                                                                <td><t t-out="admin.phone or 'N/A'"></t></td>
                                                                <td><t t-out="admin.company_id.name or 'N/A'"></t></td>
                                                                <td>
                                                                    <t t-if="admin.active">
                                                                        <span class="badge bg-success">Sí</span>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span class="badge bg-danger">No</span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-warning">
                                                <i class="fa fa-exclamation-triangle"></i> No hay administradores registrados.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <style>
                .nav-tabs .nav-link {
                    color: #495057;
                    border: 1px solid #dee2e6;
                    border-bottom: none;
                    border-radius: 0.25rem 0.25rem 0 0;
                }
                .nav-tabs .nav-link.active {
                    background-color: #fff;
                    border-color: #dee2e6 #dee2e6 #fff;
                    color: #0c63e4;
                    font-weight: 600;
                }
                .nav-tabs .nav-link:hover {
                    border-color: #0c63e4;
                    color: #0c63e4;
                }
                .table-hover tbody tr:hover {
                    background-color: #f5f5f5;
                }
                .card {
                    box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
                }
            </style>
        </t>
    </template>

</odoo>